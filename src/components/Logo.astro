---
import { brand } from "../data/content";

interface Props {
  // header: outlined dot on light background; footer: small dot on dark block
  variant?: "header" | "footer";
}

const { variant = "header" } = Astro.props;
---

{
  variant === "header" ? (
    <div class="flex items-center gap-2.5 lg:gap-3">
      <span class="size-6.5 rounded-full border-[1.5px] border-ink bg-accent lg:size-7.5" aria-hidden="true" />
      <span class="font-display text-15 font-semibold lg:text-18">{brand}</span>
    </div>
  ) : (
    <div class="flex items-center gap-2.5">
      <span class="size-5 rounded-full bg-accent lg:size-5.5" aria-hidden="true" />
      <span class="font-display text-13 font-semibold lg:text-14">{brand}</span>
    </div>
  )
}
