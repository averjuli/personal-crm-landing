---
// Decorative inline SVG icons; paths from desing/reference/*.html
export type IconName = "user" | "check" | "search" | "monitor" | "arrow-right";

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth = 2, class: className } = Astro.props;
---

<svg
  class:list={["shrink-0", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "user" && (
      <>
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
      </>
    )
  }
  {name === "check" && <path d="M20 6 9 17l-5-5" />}
  {
    name === "search" && (
      <>
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </>
    )
  }
  {
    name === "monitor" && (
      <>
        <rect x="3" y="4" width="18" height="14" rx="2" />
        <path d="M8 21h8M12 18v3" />
      </>
    )
  }
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
